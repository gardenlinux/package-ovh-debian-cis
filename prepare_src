#!/bin/bash
set -euo pipefail

pkg="debian-cis"
version_orig="2.14"
version="2.14-1"

#Upstream repo for debian-cis on 20251024
upstream_repo="https://github.com/ovh/debian-cis"
upstream_tar_url="$upstream_repo/archive/refs/tags/v${version_orig}.tar.gz"

echo "Fetching upstream source tarball"
curl -sSLf "$upstream_tar_url" | gzip -d | tee "$dir/orig.tar" | \
    tar --extract --strip-components=1 --directory "$dir/src"

echo "Debian package metadata from upstream repo"
DEBIAN_SRC="$(mktemp -d)"
trap 'rm -rf "$DEBIAN_SRC"' EXIT
git clone --depth=1 "$upstream_repo" "$DEBIAN_SRC"
cp -a "$DEBIAN_SRC/debian" "$dir/src/"

#apply_patches || true

echo "pkg=$pkg"
echo "version=$version"

